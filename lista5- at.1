#include <stdio.h>
#include <stdlib.h>

/* run this program using the console pauser or add your own getch, system("pause") or input loop */

int main(int argc, char *argv[]) {

	int vet[100];
	int i, j, aux;
	
	
	for(i=0;i<100;i++){
		printf("Digite um valor: ", i);
		scanf("%d", &vet[i]);
	}
	
	printf("\nOrdem Inversa\n");
	for(i=99;i>=0;i--){
			printf("%d\n",vet[i]);
		}
	printf("\n");
		

	for(i=0; i<100; i++){
		for(j=i+1; j<100 ; j++){
			if(vet[i]< vet[j]){
				aux = vet[i];
				vet[i] = vet[j];
				vet[j] = aux;
			}
		}
	}
	printf("\nOrdenados do maior para o menor:\n");
    for (i = 0; i < 100; i++) {
        printf("%d ", vet[i]);
    }
    printf("\n");



	return 0;
}
