#include <stdio.h>
#include <stdlib.h>
#include <math.h>
/* run this program using the console pauser or add your own getch, system("pause") or input loop */

int main(int argc, char *argv[]) {

double x1, y1;
double x2, y2;
double distancia;


scanf("%lf %lf", &x1, &y1);
scanf("%lf %lf", &x2, &y2);


distancia = sqrt(pow(x2 - x1, 2) + pow(y2 - y1, 2));


printf("%.4lf\n", distancia);

return 0;
}
