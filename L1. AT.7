#include <stdio.h>
#include <stdlib.h>

/* run this program using the console pauser or add your own getch, system("pause") or input loop */

int main(int argc, char *argv[]) {


    double R, volume;
    double pi = 3.14159;

    
    scanf("%lf", &R);

    
    volume = (4.0 / 3.0) * pi * R * R * R;

   
    printf("VOLUME = %.3lf\n", volume);

	return 0;
}
