int main(int argc, char *argv[]) {
	
	int numero[100],i;

	for(i=0; i<100; i++){
	printf("Digite o Numero %d:", i+1);
	scanf("%d", &numero[i]);
}

for(i=99; i>=0; i--){
	printf("\nNumero %d: %d", i+1, numero[i]);
}


int j, temp;

for ( i=0; i<99; i++){
	for(j=0; j<99-1;j++){
		if(numero[j]< numero[j+1]){
			temp=numero[j];
			numero[j]= numero[j+1];
			numero[j+1]= temp;
		}
	}
}
	return 0;
}
