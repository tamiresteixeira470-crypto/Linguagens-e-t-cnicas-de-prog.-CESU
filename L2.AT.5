int main(int argc, char *argv[]) {

double G, R;
double p = 3.141592;

printf("Digite o angulo em graus: ");
scanf("%lf", &G);

R = G * p / 180.0;

printf("Angulo em radianos: %.4lf\n", R);

return 0;
}
