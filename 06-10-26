#include <stdio.h>
#include <stdlib.h>

	int comparaMaior(int a, int b){
		if(a>b)return a;
		else return b;
	}
	
		int comparaMenor(int a, int b){
		if(a<b)return a;
		else return b;
	}
	
	
	int main(int argc, char *argv[]) { 
	
	int valores[10];
	int i, a, maior, menor;
	
	printf("Leitura dos valores:\n ");
	for(i=1;i<10;i++){
		scanf("%d",&valores[i]);
	}
	
	maior= valores[0];
	for(i=1; i<5; i+=2){
		int maior_temp= comparaMaior(valores[i], valores[i+2]);
		maior=comparaMaior(maior_temp, maior);
	}
	
	menor= valores[5];
	for(i=6; i<9; i+=2){
		int menor_temp= comparaMenor(valores[i], valores[i+2]);
		menor=comparaMenor(menor_temp, menor);
	}
	
	
	printf("\n");
	printf("maior |%d|",maior );
	
	
	


	return 0;
}
