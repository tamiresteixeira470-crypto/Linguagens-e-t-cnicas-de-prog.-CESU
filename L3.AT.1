#include <stdio.h>
#include <stdlib.h>
/* run this program using the console pauser or add your own getch, system("pause") or input loop */

int main(int argc, char *argv[]) {

int valor, resto,n100, n50, n10, n5, n2, n1;

printf("Digite o valor do saque: R$ ");
scanf("%d", &valor);

// Começamos o processo com o valor total digitado
resto = valor;

// Calculo das notas de 100
n100 = resto / 100;
resto = resto % 100;

// Calculo das notas de 50
n50 = resto / 50;
resto = resto % 50;

// Calculo das notas de 10
n10 = resto / 10;
resto = resto % 10;

// Calculo das notas de 5
n5 = resto / 5;
resto = resto % 5;

// Calculo das notas de 2
n2 = resto / 2;
resto = resto % 2;

// O que sobrou sao as notas de 1
n1 = resto;

// Exibicao do resumo
printf("\n=== TERMINAL INFINITY CASH ===\n");
printf("Valor sacado: R$ %d\n\n", valor);
printf("%d nota(s) de R$ 100,00\n", n100);
printf("%d nota(s) de R$ 50,00\n", n50);
printf("%d nota(s) de R$ 10,00\n", n10);
printf("%d nota(s) de R$ 5,00\n", n5);
printf("%d nota(s) de R$ 2,00\n", n2);
printf("%d nota(s) de R$ 1,00\n", n1);
    
return 0;
}
